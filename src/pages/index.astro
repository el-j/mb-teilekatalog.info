---
import Base from '../layouts/Base.astro';
import { vehicles } from '../data/catalog';
---

<Base title="Mercedes-Benz T1 Teilekatalog" description="Community-betriebener Ersatzteilkatalog für den Mercedes-Benz T1 (Bremer) – W601/W602">
  <section class="hero card" style="margin-bottom:2rem; background: linear-gradient(135deg, #003366 0%, #005599 100%); color:white; border:none;">
    <h1 style="font-size:2rem; margin-bottom:0.5rem;">MB Teilekatalog</h1>
    <p style="font-size:1.1rem; opacity:0.9; max-width:600px;">
      Ein Community-Projekt für den <strong>Mercedes-Benz T1 „Bremer"</strong> (1977–1995).
      Explodierte Zeichnungen, Teilenummern und technische Daten – frei und offen für alle.
    </p>
    <div style="margin-top:1.25rem; display:flex; gap:0.75rem; flex-wrap:wrap;">
      <a href="#models" class="btn-primary" style="background:white; color:#003366; padding:0.5rem 1.25rem; border-radius:4px; font-weight:600; text-decoration:none;">
        Modelle anzeigen →
      </a>
      <a href="/contribute/" style="background:transparent; color:white; padding:0.5rem 1.25rem; border-radius:4px; font-weight:600; text-decoration:none; border:2px solid rgba(255,255,255,0.6);">
        Mitmachen
      </a>
    </div>
  </section>

  <section id="models">
    <h2 style="font-size:1.4rem; margin-bottom:1rem; color:#003366;">Fahrzeugmodelle</h2>

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1rem;">
      {vehicles.map(v => (
        <a href={`/vehicles/${v.id}/`} class="card vehicle-card" style="display:block; color:inherit; text-decoration:none; transition:box-shadow .15s;">
          <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
            <span style="font-size:2rem;">🚐</span>
            <div>
              <div style="font-weight:700; font-size:1.05rem;">{v.name}</div>
              <div style="font-size:0.82rem; color:#555;">{v.series} · {v.years}</div>
            </div>
          </div>
          <p style="font-size:0.88rem; color:#444; margin-bottom:0.5rem;">{v.description}</p>
          <div style="font-size:0.82rem; color:#666;">
            <strong>Motor:</strong> {v.engine}
          </div>
          <div style="margin-top:0.75rem; font-size:0.82rem; color:#007bff; font-weight:600;">
            Teile anzeigen →
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="card" style="margin-top:2rem;">
    <h2 style="font-size:1.2rem; margin-bottom:0.75rem; color:#003366;">📋 Über diesen Katalog</h2>
    <p style="margin-bottom:0.75rem;">
      Dieser Katalog ist ein <strong>Community-Projekt</strong> und steht in keiner Verbindung
      zur Mercedes-Benz Group AG. Alle Daten werden von Enthusiasten beigesteuert und
      sind unter der <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener noreferrer" target="_blank">CC BY-SA 4.0</a>-Lizenz verfügbar.
    </p>
    <p style="font-size:0.88rem; color:#555;">
      Teilenummern dienen nur als Referenz. Korrekte Teilenummern sollten immer über einen
      autorisierten Mercedes-Benz Händler oder das offizielle EPC-System verifiziert werden.
    </p>
  </section>
</Base>

<style>
  .vehicle-card:hover {
    box-shadow: 0 4px 16px rgba(0,51,102,.15);
    transform: translateY(-1px);
  }
</style>
