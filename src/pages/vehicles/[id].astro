---
import Base from '../../layouts/Base.astro';
import { vehicles, partGroups } from '../../data/catalog';

export function getStaticPaths() {
  return vehicles.map(v => ({ params: { id: v.id } }));
}

const { id } = Astro.params;
const vehicle = vehicles.find(v => v.id === id)!;
---

<Base
  title={vehicle.name}
  description={`Ersatzteilkatalog für ${vehicle.name} (${vehicle.series}, ${vehicle.years})`}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" style="margin-bottom:1.5rem; font-size:0.88rem; color:#555;">
    <a href="/">Modelle</a> › <strong>{vehicle.name}</strong>
  </nav>

  <!-- Vehicle Header -->
  <div class="card" style="margin-bottom:1.5rem; display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
    <span style="font-size:4rem;">🚐</span>
    <div>
      <h1 style="font-size:1.75rem; color:#003366; margin-bottom:0.25rem;">{vehicle.name}</h1>
      <div style="color:#555; font-size:0.95rem; margin-bottom:0.5rem;">
        Baureihe {vehicle.series} · {vehicle.years}
      </div>
      <div style="font-size:0.9rem;">
        <strong>Motor:</strong> {vehicle.engine}
      </div>
      <p style="font-size:0.88rem; color:#444; margin-top:0.5rem; max-width:600px;">{vehicle.description}</p>
    </div>
  </div>

  <!-- Parts Groups -->
  <h2 style="font-size:1.3rem; color:#003366; margin-bottom:1rem;">Teilgruppen</h2>

  {partGroups.map(group => (
    <details class="card group-details" style="margin-bottom:1rem;">
      <summary style="cursor:pointer; font-size:1.1rem; font-weight:700; color:#003366; list-style:none; display:flex; align-items:center; gap:0.5rem; padding:0.25rem 0;">
        <span style="font-size:1.25rem;">{group.icon}</span>
        {group.name}
        <span style="font-size:0.8rem; color:#777; font-weight:400;">({group.nameEn})</span>
        <span class="toggle-icon" style="margin-left:auto; color:#aaa; font-size:0.9rem;">▼</span>
      </summary>

      <div style="margin-top:1rem;">
        {group.subgroups.map(sg => (
          <div style="margin-bottom:1.5rem;">
            <h3 style="font-size:0.95rem; color:#555; margin-bottom:0.75rem; border-bottom:1px solid #dde1e7; padding-bottom:0.4rem;">
              {sg.name} <span style="font-weight:400; color:#888;">/ {sg.nameEn}</span>
            </h3>

            {sg.diagrams && sg.diagrams.length > 0 && (
              <div class="diagram-gallery" style="display:flex; flex-wrap:wrap; gap:0.75rem; margin-bottom:1rem;">
                {sg.diagrams.map(src => (
                  <a href={src} target="_blank" rel="noopener noreferrer" title="Explosionszeichnung öffnen">
                    <img
                      src={src}
                      alt={`Explosionszeichnung: ${sg.nameEn}`}
                      loading="lazy"
                      style="max-height:200px; border:1px solid #dde1e7; border-radius:4px; background:#fff; cursor:zoom-in;"
                    />
                  </a>
                ))}
              </div>
            )}

            <div style="overflow-x:auto;">
              <table style="width:100%; border-collapse:collapse; font-size:0.88rem;">
                <thead>
                  <tr style="background:#f4f5f7; text-align:left;">
                    <th style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; white-space:nowrap;">Teilenummer</th>
                    <th style="padding:0.5rem 0.75rem; border:1px solid #dde1e7;">Bezeichnung (DE)</th>
                    <th style="padding:0.5rem 0.75rem; border:1px solid #dde1e7;">Description (EN)</th>
                    <th style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; text-align:center;">Menge</th>
                    <th style="padding:0.5rem 0.75rem; border:1px solid #dde1e7;">Hinweise</th>
                  </tr>
                </thead>
                <tbody>
                  {sg.parts.map((part, i) => (
                    <tr style={i % 2 === 0 ? '' : 'background:#fafbfc'}>
                      <td style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; font-family:monospace; white-space:nowrap; color:#003366; font-weight:600;">
                        {part.partNumber}
                        {part.supersededBy && (
                          <div style="font-size:0.75rem; color:#e05a00; margin-top:0.15rem;">→ {part.supersededBy}</div>
                        )}
                      </td>
                      <td style="padding:0.5rem 0.75rem; border:1px solid #dde1e7;">{part.name}</td>
                      <td style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; color:#555;">{part.nameEn}</td>
                      <td style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; text-align:center;">{part.quantity}</td>
                      <td style="padding:0.5rem 0.75rem; border:1px solid #dde1e7; color:#777; font-size:0.82rem;">{part.notes ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    </details>
  ))}

  <div class="card" style="margin-top:2rem; font-size:0.85rem; color:#666; border-left:4px solid #003366; padding-left:1.25rem;">
    <strong>Hinweis:</strong> Alle Teilenummern dienen nur als Referenz und sollten vor dem Kauf
    über einen autorisierten Mercedes-Benz Händler oder das offizielle EPC-System verifiziert werden.
    Dieses Projekt steht in keiner Verbindung zur Mercedes-Benz Group AG.
  </div>
</Base>

<style>
  .group-details[open] .toggle-icon { transform: rotate(180deg); }
  .toggle-icon { transition: transform .2s; }
  .group-details summary::-webkit-details-marker { display: none; }
</style>
